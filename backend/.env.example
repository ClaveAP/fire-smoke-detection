# ==============================================================================
# AEGISFLAME BACKEND VISION SERVICE ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya jika diperlukan:
# cp .env.example .env

# Engine deteksi: "auto" (YOLOv11 jika ada weights, fallback heuristic), "yolo", atau "heuristic"
FSD_ENGINE=auto

# Path ke bobot model YOLO (.pt)
# Default: models/fire-smoke-yolo11n/best.pt
FSD_WEIGHTS=

# Ambang batas kepercayaan deteksi (0.0 - 1.0)
FSD_CONFIDENCE=0.40

# Ambang batas IoU NMS (0.0 - 1.0)
FSD_IOU=0.45

# Device komputasi: "cuda", "cpu", atau kosongkan untuk otomatis
FSD_DEVICE=

# Daftar CORS Origins yang diizinkan (pisahkan koma)
FSD_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Batas ukuran upload file (MB)
FSD_MAX_UPLOAD_MB=25
FSD_MAX_VIDEO_UPLOAD_MB=200

# Sampling FPS untuk video batch analysis
FSD_VIDEO_SAMPLE_FPS=2.0

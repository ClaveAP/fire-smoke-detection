# ==============================================================================
# AEGISFLAME FRONTEND ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. KONEKSI BACKEND FASTAPI
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. URL FRONTEND APP
# ------------------------------------------------------------------------------
# Digunakan untuk redirect callback OAuth Google (contoh: http://localhost:3000)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. KREDENSIAL SUPABASE (POSTGRESQL & GOOGLE OAUTH)
# ------------------------------------------------------------------------------
# Dapatkan di: Supabase Dashboard > Project Settings > Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE TURNSTILE (PROTEKSI ANTI-BOT)
# ------------------------------------------------------------------------------
# Dapatkan di: Cloudflare Dashboard > Turnstile > Add Site / Widgets
# Catatan Testing: Gunakan '1x00000000000000000000AA' untuk testing selalu lolos di localhost
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA_your_site_key_here

# Kunci Rahasia Turnstile untuk Server / Backend (JANGAN gunakan awalan NEXT_PUBLIC_)
# Dimasukkan ke Supabase Dashboard > Authentication > Bot Protection, atau di server API
TURNSTILE_SECRET_KEY=0x4AAAAAA_your_secret_key_here
